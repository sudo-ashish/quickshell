#!/usr/bin/env bash
# qs-blur: Dynamic Dual Alpha + Hyprland blur toggle for QuickShell
set -euo pipefail

CMD="${1:-toggle}"
QS_DIR="${QUICKSHELL_DIR:-$HOME/quickshell}"

if command -v qs >/dev/null 2>&1; then
  QS_BIN="qs"
else
  QS_BIN="quickshell"
fi

call_ipc() {
  local target="$1"; shift
  local method="$1"; shift

  if [[ -d "$QS_DIR" ]] && "$QS_BIN" -p "$QS_DIR" ipc call "$target" "$method" "$@" 2>/dev/null; then
    return 0
  fi
  if [[ -d "$HOME/.config/quickshell" ]] && "$QS_BIN" -p "$HOME/.config/quickshell" ipc call "$target" "$method" "$@" 2>/dev/null; then
    return 0
  fi
  "$QS_BIN" ipc call "$target" "$method" "$@"
}

case "$CMD" in
  toggle)
    res=$(call_ipc theme toggleBlur)
    echo "Blur is now: $res"
    ;;
  on|enable|true|1)
    res=$(call_ipc theme setBlur on)
    echo "Blur is now: $res"
    ;;
  off|disable|false|0)
    res=$(call_ipc theme setBlur off)
    echo "Blur is now: $res"
    ;;
  status|get)
    res=$(call_ipc theme getBlur)
    echo "Blur is: $res"
    ;;
  *)
    echo "Usage: qs-blur [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
